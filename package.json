{
  "name": "renovate-vs-dependabot-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Side-by-side demo of Renovate and Dependabot on a deliberately vulnerable TypeScript API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src"
  },
  "dependencies": {
    "axios": "1.20.0",
    "express": "4.17.1",
    "jsonwebtoken": "9.0.0",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.25",
    "@types/node": "26.6.3",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "typescript": "6.0.3"
  }
}
