{
  "name": "renovate-vs-dependabot-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Side-by-side demo of Renovate and Dependabot on a deliberately vulnerable TypeScript API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src"
  },
  "dependencies": {
    "axios": "1.20.0",
    "express": "4.17.1",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.25",
    "@types/node": "20.2.5",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "10.9.1",
    "jest": "30.4.2",
    "typescript": "5.0.4"
  }
}
